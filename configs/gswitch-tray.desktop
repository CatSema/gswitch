[Desktop Entry]
Type=Application
Name=gswitch
Comment=Keyboard layout switcher tray icon
Comment[ru]=Иконка переключателя раскладки клавиатуры
Exec=gswitch-tray
TryExec=/usr/bin/gswitch-tray
Icon=gswitch
Terminal=false
StartupNotify=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
